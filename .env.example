# Copy to .env and fill in. Never commit .env.

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Pooled connection string, used by the running site.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection string, used by `prisma migrate`. Optional:
# when empty, migrations use DATABASE_URL.
DIRECT_DATABASE_URL=

# ── Admin login (Better Auth) ─────────────────────────────────────────────────
# Public URL of the site. http://localhost:3000 in development.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Used only by `npm run admin:create`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── Cloudflare R2 (images & videos) ───────────────────────────────────────────
# Leave both credentials empty in development to store uploads in public/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL or custom domain, e.g. https://media.example.com
R2_PUBLIC_URL=

# Development only: open /admin without signing in. Ignored in production builds.
ADMIN_SKIP_LOGIN=false
